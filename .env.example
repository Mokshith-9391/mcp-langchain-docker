# =============================================================
#  Copy to .env and fill in:   cp .env.example .env && nano .env
#  Keep comments on their own lines (no inline comments).
#  Ports, hosts and server URLs are set in docker-compose.yml.
# =============================================================

# ---------- LLM (the "brain" of the agent) ----------
# Anthropic examples: anthropic:claude-sonnet-5   anthropic:claude-haiku-4-5-20251001
# OpenAI example:     openai:gpt-4o-mini
LLM_MODEL=anthropic:claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------- Jira Cloud ----------
# Token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

# ---------- AWS / EC2 ----------
# On EC2 the container uses the instance's IAM role automatically.
# Do NOT put access keys here when running on EC2.
AWS_REGION=ap-south-1
# Set to true ONLY if you want the agent to start/stop instances.
EC2_ALLOW_WRITE=false
